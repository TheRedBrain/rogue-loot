{
	"schemaVersion": 1,
	"id": "rogueloot",
	"version": "${version}",
	"name": "Rogue Loot",
	"description": "Rogue Loot adds various blocks which can supply 'Lootables', an extended version of loot tables added by the 'Lootables' mod.",
	"authors": [
		"TheRedBrain"
	],
	"contact": {
		"sources": "https://github.com/TheRedBrain/lootable-blocks"
	},
	"license": "MIT",
	"icon": "assets/rogueloot/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.github.theredbrain.rogueloot.RogueLoot"
		],
		"client": [
			"com.github.theredbrain.rogueloot.RogueLootClient"
		]
	},
	"mixins": [
		"rogueloot.mixins.json",
		{
			"config": "rogueloot.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_version}",
		"fabric-api": "*",
		"fzzy_config": ">=${fzzy_config_version}"
	},
	"suggests": {
		"lootables": "*",
		"loot_n_explore": "*"
  }
}